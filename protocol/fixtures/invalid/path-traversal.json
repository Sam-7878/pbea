{
  "$schema": "https://schema.hete.io/poa/v1.json",
  "protocol_id": "hete.invalid.path",
  "version": "1.0.0",
  "mode": "production",
  "operations": [{ "name": "verify", "allowed_actors": ["actor"], "required_context": [] }],
  "process_constraints": { "os_backend": "openbsd", "pledge_promises": ["stdio"], "unveil_paths": [{ "path": "/var/hete/../etc", "permissions": "r" }], "lock_after_initialization": true },
  "data_constraints": { "input_schema": "protocol/schemas/transition-request.json", "maximum_message_bytes": 65536, "canonical_encoding": "JCS" },
  "failure_policy": { "invalid_request": "reject", "policy_violation": "reject", "repeated_violation": "quarantine", "internal_error": "abort" }
}

